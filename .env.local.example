# ============================================
# 个人 AI 助手 - 环境变量配置
# 复制此文件为 .env.local 并填入真实值
# ============================================

# ---------- 通义千问 API ----------
# 在阿里云百炼平台获取: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-

# 模型选择（OpenAI 兼容模式）
# 可选: qwen-plus, qwen-max, qwen-turbo, qwen-omni（多模态）
QWEN_MODEL=qwen-plus

# Embedding 模型（用于长期记忆向量检索）
# 可选: text-embedding-v2
QWEN_EMBEDDING_MODEL=text-embedding-v2

# ---------- Redis（持久化记忆）----------
# 推荐使用 Vercel KV (Upstash)，配置方法见 README

# 【需要你填】KV_URL: Vercel 中 Upstash Redis 的连接串
# 格式: redis://default:密码@主机.upstash.io:6379
# 【可选】显式指定使用真实 Redis
REDIS_MODE=redis

# ---------- 管理端密码 ----------
# 用于保护 /admin 页面
ADMIN_PASSWORD=

# ---------- 你的个人信息（作为 AI 的初始 System Prompt）----------
# 这里写一段关于你自己的简介，AI 会以此为基础人格
NEXT_PUBLIC_PERSONA_NAME=
NEXT_PUBLIC_PERSONA_BIO=